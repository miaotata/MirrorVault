<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BackupApp.UI.Views.PreviewView">
    <Border Padding="20" MinWidth="480" MaxWidth="640">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Title -->
            <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource AppInkBrush}"/>

            <!-- Stats row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                <TextBlock x:Name="AddedText" Foreground="#2E7D32" FontSize="13"/>
                <TextBlock x:Name="ModifiedText" Foreground="#F57F17" FontSize="13"/>
                <TextBlock x:Name="DeletedText" Foreground="#C62828" FontSize="13"/>
                <TextBlock x:Name="UnchangedText" Foreground="Gray" FontSize="13"/>
            </StackPanel>

            <!-- Section label -->
            <TextBlock Grid.Row="2" Text="变更明细:" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource AppInkBrush}" Margin="0,12,0,4"/>

            <!-- File list: takes remaining space, scrolls internally -->
            <ListBox Grid.Row="3" x:Name="FileListBox">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,3"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <!-- Buttons: pinned to bottom -->
            <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,12,0,0"
                    BorderBrush="{DynamicResource AppHairlineBrush}"
                    BorderThickness="0,0.5,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="BtnCancel" Content="取消"
                            Width="90" Height="34" FontSize="13"
                            CornerRadius="6"
                            Background="{DynamicResource AppHairlineBrush}"
                            Foreground="{DynamicResource AppInkBrush}"/>
                    <Button x:Name="BtnProceed" Content="确认执行"
                            Width="110" Height="34" FontSize="13" FontWeight="SemiBold"
                            CornerRadius="6"
                            Background="{DynamicResource AppPrimaryBrush}"
                            Foreground="{DynamicResource AppOnPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
